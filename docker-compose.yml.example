version: '3.8'

services:
  version-dashboard:
    build: .
    container_name: hub-version-dashboard
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - ./data:/app/data
    environment:
      - PORT
      - NODE_ENV
      - API_KEY
      - SMTP_USER
      - SMTP_PASS
      - SMTP_HOST
      - SMTP_PORT
      - VIEWER_KEY
      - GEMINI_API_KEY
      - JIRA_URL
      - JIRA_USER
      - JIRA_API_TOKEN
      - JIRA_PROJECT_KEY
      
  nginx-provincia-test:
    image: nginx:alpine
    ports:
      - "8082:80"
    volumes:
      - ./version.json:/usr/share/nginx/html/version.json

volumes:
  dashboard_data: